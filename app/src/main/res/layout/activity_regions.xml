<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/regions_title" android:textColor="@color/primary"
            android:textSize="28sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:text="Mesecni regionalni plasman. ★ oznacava vas region."
            android:textSize="15sp" />
        <Button android:id="@+id/button_region_challenges"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:background="@drawable/button_primary"
            android:text="Regionalni izazovi" android:textAllCaps="false"
            android:textColor="@android:color/white" />
        <com.example.mobilnekt1.regions.presentation.SerbiaMapView
            android:id="@+id/region_map" android:layout_width="match_parent"
            android:layout_height="360dp" android:layout_marginTop="12dp"
            android:background="@color/surface" />
        <LinearLayout android:id="@+id/container_regions" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="18dp"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
